def count_rows_with_zeros(matrix):
    return sum(1 for row in matrix if 0 in row)


def longest_series_column(matrix):
    rows, cols = len(matrix), len(matrix[0])
    max_length = 0
    best_column = -1

    for col in range(cols):
        max_series = 1
        current_series = 1
        for row in range(1, rows):
            if matrix[row][col] == matrix[row - 1][col]:
                current_series += 1
            else:
                current_series = 1
            if current_series > max_series:
                max_series = current_series
        if max_series > max_length:
            max_length = max_series
            best_column = col

    return best_column