def shift_matrix(matrix1, shift_amount, mode='right'):
    rows = len(matrix1)
    cols = len(matrix1[0]) if rows > 0 else 0

    if mode == 'right':
        shift_amount = shift_amount % cols
        return [
            row[-shift_amount:] + row[:-shift_amount]
            for row in matrix1
        ]
    elif mode == 'down':
        shift_amount = shift_amount % rows
        return matrix1[-shift_amount:] + matrix1[:-shift_amount]
    else:
        raise ValueError("Incorrect mode! Use 'right' or 'down'.")
