from lab0_var13 import shift_matrix
from lab0_var3 import count_rows_with_zeros, longest_series_column
from lab0_var16 import sort_rows_by_repeats, find_first_non_negative_column

# var13
matrix1 = [
    [9, 5, 2, 9],
    [4, 9, 5, 6],
    [4, 6, 9, 9]
]
shift_amount = 2
mode = 'right'
shifted_matrix = shift_matrix(matrix1, shift_amount, mode)

print("Initial matrix:")
for row in matrix1:
    print(row)

print(f"\nMatrix after {shift_amount}-shift {mode}:")
for row in shifted_matrix:
    print(row)

# var16
matrix2 = [
    [8, 6, 2, 1],
    [2, 6, 1, 2],
    [0, 9, 4, 5],
    [4, 4, 0, 6]
]
rows_with_zeros = count_rows_with_zeros(matrix2)
best_column = longest_series_column(matrix2)

print("\nNumber of rows with at least one null element:", rows_with_zeros)
print("The number of the column with the longest series of identical elements:", best_column)

# var18
matrix3 = [
    [0, 2, 7, -9],
    [4, 4, 4, 5],
    [9, -7, 2, 4],
    [7, 1, 3, 3]
]
sorted_matrix = sort_rows_by_repeats(matrix3)
first_non_negative_col = find_first_non_negative_column(sorted_matrix)

print("\nSorted matrix:")
for row in sorted_matrix:
    print(row)

print("The first column that has no negative elements:", first_non_negative_col)
